{
  "type": "module",
  "dependencies": {
    "@tensorflow/tfjs": "^4.9.0",
    "@tensorflow/tfjs-tflite": "^0.0.1-alpha.10",
    "@wojtekmaj/enzyme-adapter-react-17": "^0.8.0",
    "axios": "^1.7.9",
    "canvas": "^2.11.2",
    "prop-types": "^15.7.2",
    "punycode": "^2.3.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-redux": "^7.2.4",
    "redux": "^4.1.0",
    "styled-components": "^5.3.0",
    "text-encoding": "^0.7.0",
    "text-encoding-polyfill": "^0.6.7",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "babel-jest": "^29.7.0",
    "cheerio": "^1.0.0-rc.10",
    "enzyme": "^3.11.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "scripts": {
    "test": "jest",
    "serve": "python3 -m http.server 8000",
    "serve:node": "npx --yes http-server -p 8000 -c-1"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^@tensorflow/tfjs$": "<rootDir>/test-utils/tfjs-stub.js",
      "^@tensorflow/tfjs-tflite$": "<rootDir>/test-utils/empty-stub.js"
    },
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    }
  }
}
